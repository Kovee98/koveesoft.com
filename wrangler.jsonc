{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koveesoft",
  "compatibility_date": "2026-11-24",
  // Static assets only: no Worker script runs, so requests are free and unlimited.
  "assets": {
    "directory": "./.output/public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false,
  // Cloudflare creates the DNS records and certificates for these on deploy.
  // www is redirected to the apex by a zone Redirect Rule (see README).
  "routes": [
    { "pattern": "koveesoft.com", "custom_domain": true },
    { "pattern": "www.koveesoft.com", "custom_domain": true }
  ]
}
